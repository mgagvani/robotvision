# paths.env -- the only file to edit for a new machine or cluster.
#
#   source paths.env          # once, in the shell you submit jobs from
#   sbatch scripts/<job>.slurm
#
# Every scripts/*.slurm sources this file again inside the job, so all
# machine-specific values live here and the scripts stay untouched.

# Slurm account / partition. `sbatch` reads these from the environment, so the
# job scripts carry only resource requests (GPUs, memory, time).
export SBATCH_ACCOUNT=bgxf-dtai-gh
export SBATCH_PARTITION=ghx4

# Repository root (auto-detected from this file's location).
export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Python interpreter with the dependencies from pyproject.toml installed.
# Plain setup:  export PYTHON_BIN=$REPO_ROOT/.venv/bin/python
# The lines below are the DeltaAI (aarch64) setup where the venv's interpreter
# link is broken and torch needs the CUDA 13 libraries on the loader path.
VENV_DIR=/u/mgagvani/robotvision/.venv
export PYTHON_BIN=/u/mgagvani/.local/share/uv/python/cpython-3.12-linux-aarch64-gnu/bin/python
export PYTHONPATH="$VENV_DIR/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$VENV_DIR/lib/python3.12/site-packages/nvidia/cu13/lib:$VENV_DIR/lib/python3.12/site-packages/torch/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Hugging Face cache (Perception Encoder backbone, Depth-Anything-V2, timm weights).
# Compute nodes without internet: populate the cache once from a login node with
#   python -c "import timm, transformers as t; timm.create_model('timm/vit_pe_spatial_small_patch16_512.fb', pretrained=True); t.AutoModelForDepthEstimation.from_pretrained('depth-anything/Depth-Anything-V2-Small-hf')"
# then uncomment:  export HF_HUB_OFFLINE=1
export HF_HOME=/work/nvme/bgxf/mgagvani/hfcache/huggingface
export HF_HUB_CACHE=$HF_HOME/hub

# train.py logs to Weights & Biases; without an account use:  export WANDB_MODE=offline

# WOD-E2E v1.0.0.
#   WOD_TFRECORD_DIR: the raw TFRecords downloaded from Waymo (only needed for export).
#   DATA_DIR:         the exported per-frame dataset written by dataset/export_dataset.py.
export WOD_TFRECORD_DIR=/work/nvme/bgxf/mgagvani/wod/waymo_end_to_end_camera_v1_0_0/tfrecords
export DATA_DIR=/work/nvme/bgxf/mgagvani/wod/waymo_end_to_end_camera_v1_0_0/waymo_open_dataset_end_to_end_camera_v_1_0_0

# Where train.py writes checkpoints and logs: always $(dirname $DATA_DIR)/{checkpoints,logs}.
export CHECKPOINT_DIR="$(dirname "$DATA_DIR")/checkpoints"

# Large job outputs (ADE tables, submissions, scorer adapter, adapter ladder).
export OUTPUT_ROOT="$(dirname "$DATA_DIR")"

# The paper's SMTS checkpoint and SAE run root.
#   $RUN_ROOT/tokens/planner_tokens_{train,val}.pt   from extract_planner_tok.py
#   $RUN_ROOT/model/block_{0..3}/sae_checkpoint.pt   from train_sae.py (copies in sae_checkpoints/)
export RUN_ROOT=$REPO_ROOT/sae_run_root
export PLANNER_CHECKPOINT="$RUN_ROOT/camera-e2e-epoch=04-val_loss=2.90.ckpt"

# Counterfactual visual edits (stage 1 writes here, stage 2 and the figures read from here).
export VISUAL_GEN_ROOT=/work/hdd/bgxf/mgagvani/visual_gen_1000

# Stage 1 only: local VLM served through vLLM.
export QWEN_CHECKPOINT=/work/nvme/bgxf/mgagvani/hfcache/checkpoints/Qwen3.5-4B
